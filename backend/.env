# Application Settings
APP_NAME="Mental Health Chatbot API"
APP_VERSION="1.0.0"
DEBUG=True

# Database Configuration
# PostgreSQL example: postgresql://user:password@localhost:5432/mental_health_db
# SQLite example: sqlite:///./mental_health.db
DATABASE_URL=sqlite:///./mental_health.db
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mental-health-chatbot
# Security
SECRET_KEY=your-secret-key-here-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Settings
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ML Model Configuration
ML_MODEL_PATH=./ml/pretrained_models

# Crisis Detection
CRISIS_THRESHOLD=0.7
EMERGENCY_CONTACT=988

# File Upload
