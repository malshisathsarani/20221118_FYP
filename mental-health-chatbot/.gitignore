# ────────────────────────────────────────────────────────────────────────────────────
# PROJECT SPECIFIC
# ────────────────────────────────────────────────────────────────────────────────────

# ML models (IMPORTANT: Don't commit large model files)
backend/app/ml/pretrained_models/*.pkl
backend/app/ml/pretrained_models/*.h5
backend/app/ml/pretrained_models/*.pt
backend/app/ml/pretrained_models/*.pth
backend/app/ml/pretrained_models/*.bin
backend/app/ml_simplified/pretrained_models/*.pkl
backend/app/ml_simplified/pretrained_models/*.h5
backend/app/ml_simplified/pretrained_models/*.pt

# User data (IMPORTANT: Never commit user data)
backend/uploads/audio/*
backend/uploads/images/*
!backend/uploads/audio/.gitkeep
!backend/uploads/images/.gitkeep

# Training data
backend/app/ml/training/datasets/*.csv
backend/app/ml/training/datasets/*.json
backend/app/ml_simplified/training/datasets/*.csv

# Experiment logs
backend/app/ml/training/experiments/*
backend/app/ml_simplified/training/experiments/*

# Database backups
database_backups/
*.sql.gz

# Documentation build artifacts (if using Sphinx/MkDocs)
docs/_build/
docs/site/

# ────────────────────────────────────────────────────────────────────────────────────
# EXCEPTIONS (Files to KEEP)
# ────────────────────────────────────────────────────────────────────────────────────

# Keep .gitkeep files (to preserve empty directories)
!.gitkeep

# Keep example/template files
!.env.example
!.env.template
!config.example.json

# Keep sample datasets (small files for testing)
!sample_data.csv
!test_dataset.json

# Keep documentation
!README.md
!CONTRIBUTING.md
!LICENSE

# Keep GitHub workflows
!.github/workflows/*.yml
!.github/workflows/*.yaml

