# Root .gitignore for Mental Health Chatbot Project

# Environment variables (CRITICAL - contains secrets!)
.env
.env.local
.env.*.local
*.env

# IDE and Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Claude Code settings
.claude/settings.local.json

# OS
Thumbs.db
Desktop.ini

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
*.tmp
*.temp
temp/
tmp/
